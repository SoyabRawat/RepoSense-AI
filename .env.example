# ==============================================================================
# RepoSense AI — Environment Configuration Example (.env.example)
# Phase 3: Testing, Security, Performance & Public Release
#
# Instructions:
# 1. Copy this file to '.env' in the project root or 'backend/.env'.
# 2. Adjust values as appropriate for your environment.
# 3. NEVER commit real secrets, private keys, or credentials to version control.
# ==============================================================================

# Application Meta
APP_NAME=RepoSense AI Backend
APP_VERSION=0.3.0
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (comma-separated list for local development and staging)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# GitHub Integration & Rate Limit Handling
# Optional: Public repos can be explored without a token (60 requests/hour limit).
# Provide a GitHub Personal Access Token (classic with public_repo or fine-grained)
# to increase rate limits to 5,000 requests/hour.
GITHUB_TOKEN=

# Ingestion Guardrails & Resource Limits
MAX_TREE_ENTRIES=5000
MAX_FILE_SIZE_BYTES=1048576          # 1 MB maximum per individual source file
MAX_TOTAL_SOURCE_BYTES=26214400      # 25 MB maximum total retrieved source content
MAX_FILES_PROCESSED=600              # Maximum files fetched and parsed in single repo
REQUEST_TIMEOUT_SECONDS=30.0         # HTTP client timeout against upstream APIs

# AI Provider Configuration
# Supported providers: "none" (deterministic AI-free mode), "gemini", "openai", "anthropic", "ollama"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_API_BASE=

# Storage & Cache
SQLITE_DB_PATH=reposense_cache.db
